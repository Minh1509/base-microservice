{
  "name": "@base/auth-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm -w exec nest start auth-service --watch --preserveWatchOutput",
    "build": "pnpm -w exec nest build auth-service",
    "start": "node ../../dist/apps/auth-service/main",
    "lint": "eslint src --max-warnings=0",
    "test": "pnpm -w exec jest apps/auth-service --passWithNoTests",
    "mikro": "cross-env MIKRO_ORM_CLI_CONFIG=apps/auth-service/mikro-orm.config.ts pnpm -w exec mikro-orm",
    "migration:create": "pnpm mikro migration:create --blank --name",
    "migration:run": "pnpm mikro migration:up",
    "migration:revert": "pnpm mikro migration:down",
    "migration:fresh": "pnpm mikro migration:fresh",
    "seed": "pnpm mikro seeder:run",
    "seed:only": "pnpm mikro seeder:run --class",
    "command:run": "cross-env MIKRO_ORM_CLI_CONFIG=apps/auth-service/mikro-orm.config.ts pnpm -w exec ts-node -r tsconfig-paths/register apps/auth-service/src/cli.ts"
  }
}
