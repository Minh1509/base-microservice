{
  "name": "base-microservice",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"{apps,libs}/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "dev:gateway": "nest start api-gateway --watch --preserveWatchOutput",
    "dev:auth": "nest start auth-service --watch --preserveWatchOutput",
    "dev:user": "nest start user-service --watch --preserveWatchOutput",
    "build:gateway": "nest build api-gateway",
    "build:auth": "nest build auth-service",
    "build:user": "nest build user-service",
    "start:gateway": "node dist/apps/api-gateway/main",
    "start:auth": "node dist/apps/auth-service/main",
    "start:user": "node dist/apps/user-service/main",
    "mikro:auth": "cross-env MIKRO_ORM_CLI_CONFIG=apps/auth-service/mikro-orm.config.ts mikro-orm",
    "mikro:user": "cross-env MIKRO_ORM_CLI_CONFIG=apps/user-service/mikro-orm.config.ts mikro-orm",
    "migration:auth:create": "pnpm mikro:auth migration:create --blank --name",
    "migration:auth:up": "pnpm mikro:auth migration:up",
    "migration:auth:down": "pnpm mikro:auth migration:down",
    "migration:auth:fresh": "pnpm mikro:auth migration:fresh",
    "migration:user:create": "pnpm mikro:user migration:create --blank --name",
    "migration:user:up": "pnpm mikro:user migration:up",
    "migration:user:down": "pnpm mikro:user migration:down",
    "migration:user:fresh": "pnpm mikro:user migration:fresh",
    "seed:auth": "pnpm mikro:auth seeder:run",
    "seed:auth:only": "pnpm mikro:auth seeder:run --class",
    "seed:user": "pnpm mikro:user seeder:run",
    "seed:user:only": "pnpm mikro:user seeder:run --class",
    "cli:auth": "ts-node -r tsconfig-paths/register apps/auth-service/src/cli.ts",
    "cli:user": "ts-node -r tsconfig-paths/register apps/user-service/src/cli.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.14",
    "@mikro-orm/migrations": "^6.6.14",
    "@mikro-orm/nestjs": "^6.1.2",
    "@mikro-orm/postgresql": "^6.6.14",
    "@mikro-orm/reflection": "^6.6.14",
    "@mikro-orm/seeder": "^6.6.14",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.2",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "kafkajs": "^2.2.4",
    "nest-commander": "^3.20.1",
    "nest-winston": "^1.10.2",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mikro-orm/cli": "^6.6.14",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "pm2": "^5.4.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.9.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "prettier --write"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^@app/core(|/.*)$": "<rootDir>/libs/core/src/$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1"
    }
  }
}
